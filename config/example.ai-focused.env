APP_ENV=local
APP_TIMEZONE=America/New_York
APP_DIGEST_HOUR=8
APP_DIGEST_MINUTE=0
APP_MAX_ITEMS=15
APP_FETCH_RETRIES=2
APP_SEND_RETRIES=1

DATABASE_URL=sqlite:///var/daily_brief.db
RAW_PAYLOAD_DIR=var/raw
OUTBOX_DIR=var/outbox

LOG_LEVEL=INFO
LOG_JSON=true

SOURCE_FILE_ENABLED=false
SOURCE_ARXIV_ENABLED=true
SOURCE_ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
SOURCE_ARXIV_KEYWORDS=reasoning,agents,alignment,benchmark
SOURCE_ARXIV_MAX_RESULTS=12

SOURCE_GITHUB_ENABLED=true
SOURCE_GITHUB_TRACKED_REPOS=openai/openai-python,huggingface/transformers,vllm-project/vllm
SOURCE_GITHUB_KEYWORDS=release,agent,inference,serving
SOURCE_GITHUB_EVENTS_PER_REPO=6

SOURCE_GITHUB_TRENDING_ENABLED=true
SOURCE_GITHUB_TRENDING_KEYWORDS=llm,agent,inference
SOURCE_GITHUB_TRENDING_MAX_RESULTS=3

SOURCE_HN_ENABLED=true
SOURCE_HN_LISTS=top,new
SOURCE_HN_KEYWORDS=llm,agents,inference,benchmark,open source
SOURCE_HN_MAX_STORIES=25

SOURCE_RSS_ENABLED=true
SOURCE_RSS_FEEDS=https://openai.com/news/rss.xml,https://www.anthropic.com/news/rss.xml
SOURCE_RSS_KEYWORDS=llm,ai,agents,reasoning,benchmark
SOURCE_RSS_MAX_ITEMS_PER_FEED=10

RANKING_PRIORITY_KEYWORDS=llm,reasoning,agents,inference,alignment,benchmark,serving
RANKING_GRAD_KEYWORDS=phd,graduate,grad school,statement of purpose,admission
RANKING_SPORTS_KEYWORDS=nba,warriors,lakers,playoffs,finals
RANKING_MAX_ITEMS_PER_TOPIC=5
RANKING_MAX_TOTAL_ITEMS=15

SUMMARIZER_PROVIDER=extractive
SUMMARIZER_MAX_ITEMS=5

EMAIL_PROVIDER=console
EMAIL_FROM=daily-brief@example.com
EMAIL_TO=you@example.com
EMAIL_SUBJECT_PREFIX=[Daily Brief]
