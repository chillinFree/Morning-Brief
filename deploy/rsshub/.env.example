# RSSHub secrets for docker-compose. Copy to `.env` in this folder and fill in.
#   cp deploy/rsshub/.env.example deploy/rsshub/.env
#
# X / Twitter: paste the `auth_token` cookie value from a logged-in X account.
# Use a throwaway account — X may rate-limit or suspend accounts used this way.
# How to get it: log in to x.com in a browser, open DevTools > Application >
# Cookies > https://x.com, copy the value of the `auth_token` cookie.
TWITTER_AUTH_TOKEN=
