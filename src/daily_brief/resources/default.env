APP_ENV=local
APP_TIMEZONE=America/New_York
APP_DIGEST_HOUR=8
APP_DIGEST_MINUTE=0
APP_MAX_ITEMS=10
APP_SCHEDULER_MISFIRE_GRACE_SECONDS=1800
APP_FETCH_RETRIES=2
APP_SEND_RETRIES=1

DATABASE_URL=sqlite:///var/daily_brief.db
RAW_PAYLOAD_DIR=var/raw
OUTBOX_DIR=var/outbox

LOG_LEVEL=INFO
LOG_JSON=true

# If this file is missing, the agent falls back to a bundled demo sample,
# so the zero-config `dry-run` works out of the box. Point it at your own
# JSON file to use real data.
SOURCE_FILE_PATH=data/sample_brief_items.json
SOURCE_FILE_ENABLED=true

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
HTTP_USER_AGENT=daily-brief-agent/0.1

SOURCE_ARXIV_ENABLED=false
SOURCE_ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
SOURCE_ARXIV_KEYWORDS=reasoning,agents,alignment
SOURCE_ARXIV_MAX_RESULTS=10

SOURCE_GITHUB_ENABLED=false
SOURCE_GITHUB_TRACKED_REPOS=openai/openai-python,huggingface/transformers
SOURCE_GITHUB_KEYWORDS=release,agent,inference
SOURCE_GITHUB_EVENTS_PER_REPO=5

SOURCE_GITHUB_TRENDING_ENABLED=false
SOURCE_GITHUB_TRENDING_KEYWORDS=
SOURCE_GITHUB_TRENDING_MAX_RESULTS=3

SOURCE_HN_ENABLED=false
SOURCE_HN_LISTS=top,new
SOURCE_HN_KEYWORDS=llm,agents,inference,benchmark
SOURCE_HN_MAX_STORIES=20

SOURCE_RSS_ENABLED=false
SOURCE_RSS_FEEDS=https://openai.com/news/rss.xml,https://feeds.feedburner.com/oreilly/radar
SOURCE_RSS_KEYWORDS=llm,ai,agents,ml
SOURCE_RSS_MAX_ITEMS_PER_FEED=10

GITHUB_TOKEN=

# Options: extractive (default, no API needed), openai_compatible, glm
SUMMARIZER_PROVIDER=extractive
SUMMARIZER_MAX_ITEMS=5

# --- GLM (智谱) ---
# SUMMARIZER_PROVIDER=glm
# SUMMARIZER_MODEL=glm-4-flash
# SUMMARIZER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# SUMMARIZER_API_KEY=your-zhipu-api-key

# --- OpenAI ---
# SUMMARIZER_PROVIDER=openai_compatible
# SUMMARIZER_MODEL=gpt-4o-mini
# SUMMARIZER_BASE_URL=https://api.openai.com/v1
# SUMMARIZER_API_KEY=

SUMMARIZER_TEMPERATURE=0.2
SUMMARIZER_REQUEST_TIMEOUT_SECONDS=30

WORKFLOW_ARTIFACT_ROOT=runs
WORKFLOW_CHECKPOINT_ENABLED=true
WORKFLOW_CHECKPOINT_PATH=runs/checkpoints/workflow.pkl
WORKFLOW_CANDIDATE_LIMIT=12
WORKFLOW_MIN_SELECTED_ITEMS=4
WORKFLOW_MAX_SELECTED_ITEMS=8
WORKFLOW_INCLUDE_THRESHOLD=0.62
WORKFLOW_FALLBACK_INCLUDE_THRESHOLD=0.48
WORKFLOW_PLANNING_MIN_SECTIONS=2
WORKFLOW_PLANNING_MAX_SECTIONS=4
WORKFLOW_LLM_MAX_RETRIES=2

RANKING_RECENCY_WEIGHT=0.3
RANKING_ENGAGEMENT_WEIGHT=0.15
RANKING_SOURCE_QUALITY_WEIGHT=0.2
RANKING_KEYWORD_AFFINITY_WEIGHT=0.2
RANKING_TOPIC_AFFINITY_WEIGHT=0.15
RANKING_TITLE_SIMILARITY_THRESHOLD=0.92
RANKING_MAX_ITEMS_PER_TOPIC=5
RANKING_MAX_TOTAL_ITEMS=15
RANKING_PRIORITY_KEYWORDS=llm,reasoning,agents,inference,alignment,benchmark
RANKING_GRAD_KEYWORDS=phd,graduate,grad school,statement of purpose,admission
RANKING_SPORTS_KEYWORDS=nba,warriors,lakers,playoffs,finals

# Default sender is `console`, which needs no secrets and writes rendered
# emails to var/outbox/. Switch to feishu/gmail_api/smtp once configured below.
EMAIL_PROVIDER=console
EMAIL_FROM=daily-brief@example.com
EMAIL_TO=you@example.com
EMAIL_SUBJECT_PREFIX=[Daily Brief]
EMAIL_PREVIEW_BEFORE_SEND=true
EMAIL_REPLY_TO=

GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=var/gmail_token.json
GMAIL_USER_ID=me

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Feishu (飞书群自定义机器人 webhook) ---
# Set FEISHU_ENABLED=true and EMAIL_PROVIDER=feishu to deliver to a Feishu group bot.
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-id
FEISHU_SECRET=
FEISHU_MESSAGE_TYPE=interactive
